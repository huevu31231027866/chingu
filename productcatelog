/* 3. Hiệu ứng khi di chuột vào nút */
.product-small.box .add-to-cart-button:hover,
.product-small.box .add_to_cart_button:hover {
    background-color: #e67a1a !important;
    transform: scale(1.1);
}

/* 4. Giữ nguyên viền bao quanh toàn bộ Card và Bo góc */
.product-small.box {
    border: 2px solid #f1f1f1 !important; /* Viền bao quanh ảnh và chữ */
    border-radius: 40px !important;       /* Bo góc khung ngoài cực mạnh */
    background-color: #ffffff !important;
    overflow: hidden !important;
    position: relative !important;
    transition: all 0.3s ease;
}

/* 5. Căn chỉnh ảnh và chữ lùi vào trong viền */
.product-small.box .box-image {
    padding: 15px 15px 5px 15px !important;
}

.product-small.box .box-image .image-cover,
.product-small.box .box-image img {
    border-radius: 30px !important; /* Bo góc ảnh bên trong */
}

.product-small.box .box-text {
    padding: 10px 25px 30px 25px !important;
    text-align: left !important;
}
/quickview/
/* Ép khung công cụ của ảnh thụt vào 15px mỗi bên */
.product-small.box .box-image .image-tools {
    left: 15px !important; 
    right: 15px !important;
    width: auto !important; /* Để nó tự co theo lề trái/phải đã set */
}

/* Giữ bo góc cho nút */
.product-small.box .quick-view {
    border-radius: 0 0 30px 30px !important;
	 max-width: calc(100% - 30px) !important; /* Ép chiều ngang tối đa bằng ảnh */
    left: 50% !important;                    /* Đưa về chính giữa */
    transform: translateX(-30%) !important;  /* Giữ nút luôn cân xứng */
}
